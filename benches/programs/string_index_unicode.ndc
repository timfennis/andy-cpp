// Same codepoint count and access pattern as string_index_ascii.ndc,
// with a mix of 1-, 2-, 3-, and 4-byte UTF-8 codepoints.
let text = "aé中😀";
for _ in 0..15 {
    text <>= text;
}
let last = text.len - 1;
let matches = 0;
for i in 0..10_000 {
    if text[last - i % 4] == "😀" {
        matches += 1;
    }
}
assert_eq(matches, 2_500);
print(matches);
