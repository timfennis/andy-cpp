// `take_while` and `skip_while` call a function, so on a list, string or
// range they give a list, as their lazy versions give a lazy sequence.
// expect-output: [1,2] []
// expect-output: [3,1] [1,2,3,1]
// expect-output: ["a","b"] [3,4]
print([1, 2, 3, 1].take_while(fn(x) => x < 3), [5].take_while(fn(x) => x < 3));
print([1, 2, 3, 1].skip_while(fn(x) => x < 3), [1, 2, 3, 1].skip_while(fn(x) => x > 3));
print("abc".take_while(fn(c) => c != "c"), (1..=4).skip_while(fn(x) => x < 3));
