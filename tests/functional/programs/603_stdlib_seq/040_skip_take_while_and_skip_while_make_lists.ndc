// `skip`, `take_while` and `skip_while` on a list, string or range give a
// list, as their lazy versions give a lazy sequence.
// expect-output: [3,4] ["c"] [4,5]
// expect-output: [1,2] []
// expect-output: [3,1] [1,2,3,1]
let xs = [1, 2, 3, 4];
print(xs.skip(2), "abc".skip(2), (1..=5).skip(3));
print([1, 2, 3, 1].take_while(fn(x) => x < 3), [5].take_while(fn(x) => x < 3));
print([1, 2, 3, 1].skip_while(fn(x) => x < 3), [1, 2, 3, 1].skip_while(fn(x) => x > 3));
