// A range is a value: iterating over it, slicing with it or asking what's in
// it leaves it as it was, so a range in a variable can be used again. Two
// ranges are equal when they give the same Ints, and a range can be a map key.
// expect-output: [1,2,3] [1,2,3]
// expect-output: [(1,1),(1,2),(2,1),(2,2)]
// expect-output: [2,3] [2,3] [1,2,3,4,5]
// expect-output: true false true true
// expect-output: true true true false
// expect-output: 3 0 4
// expect-output: a b
// expect-output: 1..4 1..=3 5..
// expect-output: [5,6,7]

let r = 1..4;
print([x for x in r], [x for x in r]);

let s = 1..3;
print([(x, y) for x in s, y in s]);

let xs = [1, 2, 3, 4, 5];
let middle = 1..3;
print(xs[middle], xs[middle], xs[0..5]);

print(3 in r, 4 in r, 4 in (1..), 1_000_000 in (1..));
print((1..=3) == (1..4), (5..3) == (0..0), (1..) == (1..), (1..3) == (1..4));
print(len(r), len(5..3), len(0..=3));

let seen = %{1..10: "a", 2..10: "b"};
print(seen[1..=9], seen[2..10]);

print(r, 1..=3, 5..);

let from = 5..;
print([x for x in from.take(3)]);
