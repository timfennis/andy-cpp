assert_eq((1..10).sum(), 45);
assert_eq((1,2,3,4).sum(), 10);
assert_eq([1,2,3,4,5].sum(), 15);
assert_eq([1.0,2.0,3.0].sum(), 6.0);
assert_eq([1n,2n,3n].sum(), 6n);

// The first push settles `deque` as a Deque<Int>, which the cast says again,
// so `sum` resolves against its Int overload.
let deque = Deque();
deque.push_back(1);
deque.push_back(2);
deque.push_back(3);
assert_eq(cast::<Deque<Int>>(deque).sum(), 6);
