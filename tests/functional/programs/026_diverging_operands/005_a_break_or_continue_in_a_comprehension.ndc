// In a comprehension, `continue` in the element skips it and `break` stops
// the comprehension, which gives the elements made so far. The same in a
// guard, and in a map comprehension.
// expect-output: [1,3,5]
// expect-output: [0,1,2,3]
// expect-output: [0,2]
// expect-output: [0,1,3,4,5]
// expect-output: [(0,0),(1,0),(1,1),(2,0),(2,1),(2,2)]
// expect-output: [(0,0),(2,4),(3,9)]
// expect-output: [(0,0),(1,1)]

fn add(a: Int, b: Int) -> Int { a + b }

print([add(i, if i % 2 == 0 { continue } else { 0 }) for i in 0..6]);
print([add(i, if i == 4 { break } else { 0 }) for i in 0..6]);
print([i for i in 0..6, if if i == 4 { break } else { i % 2 == 0 }]);
print([i for i in 0..6, if if i == 2 { continue } else { true }]);
print([(i, j) for i in 0..3, j in 0..3, if if j > i { break } else { true }]);
print(%{i: if i == 1 { continue } else { i * i } for i in 0..4}.sorted);
print(%{i: if i == 2 { break } else { i } for i in 0..4}.sorted);
