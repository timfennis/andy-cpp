// A `continue` or `break` in a call's argument or an operator's operand
// skips the call: the iteration ends without it, and the loop goes on or
// stops. Leftover operands don't pile up, which
// `900_bugs/bug0032_diverging_operand_cleanup.ndc` checks with `assert`s.
// expect-output: [0,1,3,4]
// expect-output: [0,1,2]
// expect-output: [1,3,4]
// expect-output: [(0,%{0: 0}),(1,%{1: 1}),(3,%{3: 9})]
// expect-output: 3

fn add(a: Int, b: Int) -> Int { a + b }

let seen = [];
for i in 0..5 {
    seen.push(add(i, if i == 2 { continue } else { 0 }));
}
print(seen);

let until = [];
for i in 0..5 {
    until.push(add(i, if i == 3 { break } else { 0 }));
}
print(until);

let w = 0;
let in_while = [];
while w < 5 {
    w += 1;
    in_while.push(w * if w == 2 { continue } else { 1 });
    if w == 4 { break; }
}
print(in_while);

let m = %{};
for i in 0..4 {
    m[i] = %{i: if i == 2 { continue } else { i * i }};
}
print(m.sorted);

fn in_a_map_value() -> Int {
    let n = 0;
    while true {
        n += 1;
        let m = %{"a": 1, "b": if n < 3 { continue } else { break }};
    }
    n
}
print(in_a_map_value());
