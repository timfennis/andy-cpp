// A lambda that an instance of a generic function makes takes what that
// instance's types make it take, so through `Any` it isn't a function that
// takes a String.
// expect-error: cannot cast Fn(Int) -> String to Fn(String) -> String
fn show(x: Int) => "int";
fn show(x) => "other";
fn mk(x) { fn(y) { let l = [x]; l.push(y); show(l[1]) } }
print(mk(1)(2));
let a: Any = mk(1);
print((a as Fn(String) -> String)("s"));
