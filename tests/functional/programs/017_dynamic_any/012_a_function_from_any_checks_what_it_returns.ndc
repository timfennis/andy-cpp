// A function of type `Any` used as a `Fn(Int) -> Int` checks what each call
// returns when its own type doesn't say: `text`'s value takes and returns
// anything.
// expect-error: expected the function to return Int but it returned String
fn show(x: Int) { "int" }
fn show(x: String) { "string" }
fn text(x) => "s";
let a: Any = text;
let f: Fn(Int) -> Int = a;
let n: Int = f(1);
print(show(n), n);
