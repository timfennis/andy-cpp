// This test validates that using the |=, &= and -= operators modifies the
// variable in place

let x = %{
  "foo": 1,
  "bar": 2,
};

let y = x;

x |= %{"baz": 3};

assert(x == y);
assert(x.len == 3);
assert(y.len == 3);

let z = x;

z &= %{"bar": 10};

assert(x == y and y == z);
assert(x.len == 1 and y.len == 1 and z.len == 1);

z -= %{"bar"};

assert(x == y and y == z);
assert(x.is_empty() and y.is_empty() and z.is_empty());

