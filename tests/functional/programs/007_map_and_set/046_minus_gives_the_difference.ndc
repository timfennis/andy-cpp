// `-` gives the keys of the left map or set that aren't in the right one, with
// the left one's values and default, as `-=` does in place. `difference` is
// its name.
// expect-output: [1,3]
// expect-output: %{"b": 2}
// expect-output: 0
// expect-output: [1,2,3]
// expect-output: %{}

let s = %{1, 2, 3};
print((s - %{2, 4}).keys().sorted());
print(%{"a": 1, "b": 2} - %{"a"});
let d = %{:0, 1: 1} - %{1: "x"};
print(d[5]);
print(s.keys().sorted());
print(s.difference(s));
