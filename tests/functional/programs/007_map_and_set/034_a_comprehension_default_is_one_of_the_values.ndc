// The default is a String, so a read may give one, not just the Ints: the
// values are `Any`s, which go to `g(Any)`. A type test tells what each one
// holds.
// expect-output: any str int
fn g(x: Int) => "int";
fn g(x: String) => "str";
fn g(x: Any) => "any";
fn what(x: Any) {
    if (x as? Int).is_some() {
        g(x as Int)
    } else if (x as? String).is_some() {
        g(x as String)
    } else {
        g(x)
    }
}
let m: Map<Int, Any> = %{:"missing", x: x for x in 1..3};
print(g(m[1]), what(m[99]), what(m[1]));
