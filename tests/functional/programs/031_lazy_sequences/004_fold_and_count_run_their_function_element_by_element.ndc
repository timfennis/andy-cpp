// A function that reads a lazy sequence and calls a function of its own runs
// it element by element with the sequence's steps.
// expect-output: make 1
// expect-output: add 1
// expect-output: make 2
// expect-output: add 2
// expect-output: 3
// expect-output: 2 3
let made = [1, 2].lazy.map(fn(x) { print("make", x); x });
print(made.fold(0, fn(sum, x) { print("add", x); sum + x }));
let numbers = (1..=3).lazy;
print(numbers.count(fn(x) => x > 1), numbers.count());
