// A lazy sequence made from an iterator reads its own copy of it, from where
// the iterator was when the sequence was made: reading the sequence again
// starts over, two loops over it nest, and reading the iterator afterwards
// doesn't change it.
// expect-output: [7,7] [7,7]
// expect-output: [(1,1),(1,2),(2,1),(2,2)]
// expect-output: [0,1,2]
let sevens = repeat(7, 2).lazy;
print(sevens.list, sevens.list);
let pair = [1, 2].take(2).lazy;
print([(a, b) for a in pair, b in pair]);
let numbers = [0, 1, 2].take(3);
let lazy_numbers = numbers.lazy;
for n in numbers {}
print(lazy_numbers.list);
