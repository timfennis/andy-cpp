// A function that needs every element makes them all, as a `for` loop or a
// comprehension does.
// expect-output: [3,1,2] 3 [1,2,3]
// expect-output: 6 6 1 3 3-1-2
// expect-output: 3
// expect-output: 1
// expect-output: 2
// expect-output: [3,1,2]
let numbers = [3, 1, 2].lazy;
print(numbers.list, numbers.set.len, numbers.sorted);
print(numbers.sum, numbers.product, numbers.min, numbers.max, numbers.join("-"));
for n in numbers { print(n); }
print([n for n in numbers]);
