// `a ++ [3]` on a parameter leaves the caller's list alone, also when the
// caller passed a list nothing else holds, and when the function is generic.
// expect-output: ([1,2],[1,2,3]) [1,2]
// expect-output: ([1,2],[1,2,3])
// expect-output: [1,2,3] [1,2]
// expect-output: [1,2,3] [1,2]

fn concat(a: [Int]) -> ([Int], [Int]) {
    let b = a ++ [3];
    (a, b)
}

let held = [1, 2];
print(concat(held), held);
print(concat([1, 2]));

fn generic(a) {
    a ++ [3]
}
let kept = [1, 2];
print(generic(kept), kept);

let lambda = fn(a) { a ++ [3] };
print(lambda(kept), kept);
