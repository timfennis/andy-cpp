// A comparison reads its left operand before the right one runs: in
// `x < { x = 5; x }` the left `x` is still 1.
// expect-output: true 5
// expect-output: (true,true,false,1,9)
// expect-output: (false,5)
// expect-output: (false,0)
// expect-output: true

let g = 1;
print(g < { g = 5; g }, g);

fn local() {
    let x = 1;
    let less = x < { x = 5; x };
    let equal = x == { x = 7; 5 };
    let differ = x != { x = 1; 7 };
    let order = x <=> { x = 9; 0 };
    (less, equal, differ, order, x)
}
print(local());

fn cell() {
    let x = 1;
    let read = fn() { x };
    (x >= { x = 5; x }, read())
}
print(cell());

fn upvalue() {
    let x = 1;
    let compare = fn() { x <= { x = 0; x } };
    (compare(), x)
}
print(upvalue());

fn contains() {
    let x = 1;
    x in { x = 2; [1] }
}
print(contains());
