// A range reads its start before its end runs: `x..{ x = 4; x }` is `1..4`.
// expect-output: [1,2,3]
// expect-output: ([1,2,3],[4,5,6])
// expect-output: ([1,2],3)
// expect-output: [1,2]
// expect-output: [(0,3),(1,3),(2,3)]

let g = 1;
print(list(g..{ g = 4; g }));

fn local() {
    let x = 1;
    (list(x..{ x = 4; x }), list(x..={ x = 6; x }))
}
print(local());

fn cell() {
    let x = 1;
    let read = fn() { x };
    (list(x..{ x = 3; x }), read())
}
print(cell());

fn upvalue() {
    let x = 1;
    let make = fn() { list(x..{ x = 3; x }) };
    make()
}
print(upvalue());

fn for_loop() {
    let x = 0;
    let seen = [];
    for i in x..{ x = 3; x } {
        seen.push((i, x));
    }
    seen
}
print(for_loop());
