// Constructors and getters are hashable function values, so they can be used
// as map keys. Identity is per-struct: a getter is tied to the struct it was
// declared in, not just to the field name.
struct Point {
    x: Int,
    y: Int,
}

// Round-trips through the map.
let by_getter = %{x: "the x field", y: "the y field"};
assert_eq(by_getter.len(), 2);
assert_eq(by_getter[x], "the x field");
assert_eq(by_getter[y], "the y field");

assert(x == x);
assert(x != y);

// Constructors are keys too.
let by_ctor = %{Point: "the Point constructor"};
assert_eq(by_ctor[Point], "the Point constructor");

// A same-named field on another struct is a distinct getter. Once both
// exist, `x` used as a value needs a type to say which one it is.
let point_x = x;
struct Other {
    x: Int,
}
let other_x: Fn(Other) -> Int = x;

assert(point_x != other_x);
// The two getters have different types, so the keys are typed `Any`.
let both: Map<Any, String> = %{point_x: "Point", other_x: "Other"};
assert_eq(both.len(), 2);
assert_eq(both[point_x], "Point");
assert_eq(both[other_x], "Other");
