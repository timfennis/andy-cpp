let object: Map<String, Any> = %{
    "foo": "bar",
    "int": 123,
    "float": 123.123,
    "unit": (),
    "set": %{"a", "b"},
    "object": %{
        "test": [1,2,3]
    },
    "list": [1,2,3,4],
};

let result: Map<String, Any> = %{
    "float": 123.123,
    "foo": "bar",
    "unit": (),
    "set": %{"a", "b"},
    "int": 123,
    "object": %{
        "test": [1,2,3]
    },
    "list": [1,2,3,4]
};

assert_eq(result, object.json_encode.json_decode);
