// `f`'s type doesn't show what its `[]` holds, so each call of `f`, or of
// `g`, says it. Here none does, so it's `Unknown`, which neither `pick`
// takes.
// expect-error: No function called 'pick' found that matches the arguments '[Unknown], Int'
fn pick(xs: [Int], x: Int) => 1;
fn pick(xs: [Any], x: Any) => 2;
fn f(x) => pick([], x);
let g: fn(Int) -> Int = f;
print(g(3), f(3));
