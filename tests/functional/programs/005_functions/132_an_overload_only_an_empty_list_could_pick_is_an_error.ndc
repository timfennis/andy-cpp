// What the `[]` holds is all that could pick an overload of `pick`, and
// nothing says what it is, in `f`'s value or in a call of it.
// expect-error: can't tell which `pick` this is: part of what it's given has no known type
fn pick(xs: List<Int>, x: Int) => 1;
fn pick(xs: List<Any>, x: Any) => 2;
fn f(x) => pick([], x);
let g: Fn(Int) -> Int = f;
print(g(3), f(3));
