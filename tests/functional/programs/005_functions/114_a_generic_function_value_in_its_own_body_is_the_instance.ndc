// A generic function's value in its own body has the body's types, so each
// instance's value of it is that instance.
// expect-output: [2] [2.5]
fn walk(xs, n) {
    if n == 0 {
        return xs.map(fn(x) => x + 1);
    }
    let me = walk;
    me(xs, n - 1)
}
print(walk([1], 3), walk([1.5], 2));
