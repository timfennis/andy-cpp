// A function value whose overload the program picks, used as a function
// type through `Any`, gets its calls checked like any function.
// expect-error: expected the function to return String but it returned Int
fn bad(x) {
    let g = abs;
    g(x);
    let a: Any = g;
    let b: Fn(Int) -> String = a;
    b(1)
}
let h: Fn(Int) -> String = bad;
print(h(1));
