// Indexing a map looks the key up in it, so the key is what the map's keys
// are: an `Any` takes a cast.
// expect-error: No function called 'lookup' found that matches the arguments 'Any'
fn lookup(k) {
    let m: %{String: Int} = %{"a": 1};
    m[k]
}
let a: Any = "a";
print(lookup("a"), lookup(a));
