fn square(x) {
    return x * x;
}
fn add(a, b) { a + b }
fn sub(a, b) { a - b }

let my_num = 5;
assert_eq(25, my_num.square);    // `value.function`
assert_eq(25, my_num.square());  // `value.function()`
assert_eq(25, square(my_num));   // `function(value)`

// The value before the dot is the first argument.
assert_eq(1.add(2), 3);
assert_eq(9.0.sqrt(), 3.0);
assert_eq(10.sub(1).sub(2), 7);
