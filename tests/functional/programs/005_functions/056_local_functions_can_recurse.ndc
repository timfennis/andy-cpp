// A local function can call itself, also when it's memoized.
fn outer() {
    fn fact(n) { if n == 0 { 1 } else { n * fact(n - 1) } }
    pure fn fib(n) { if n < 2 { n } else { fib(n - 1) + fib(n - 2) } }
    let results = (fact(5), fib(30));
    results
}
print(outer());
// expect-output: (120,832040)

// A recursive function declared in a loop sees its own iteration's variables.
let counters = [];
for i in 1..=3 {
    fn countdown(n) { if n == 0 { i } else { countdown(n - 1) } }
    counters.push(countdown);
}
print([c(2) for c in counters]);
// expect-output: [1,2,3]
