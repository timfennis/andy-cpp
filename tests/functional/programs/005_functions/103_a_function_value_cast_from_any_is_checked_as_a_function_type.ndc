// A function value whose overload the program picks, cast to a function type
// from `Any`, gets its calls checked like any function.
// expect-error: expected the function to return String but it returned Int
fn bad(x) {
    let g = abs;
    g(x);
    let a: Any = g;
    let b = a as Fn(Int) -> String;
    b(1)
}
let h: Fn(Int) -> String = bad;
print(h(1));
