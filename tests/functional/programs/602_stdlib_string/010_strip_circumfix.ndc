assert_eq(strip_circumfix("[hello]", "[", "]"), "hello");
assert_eq("[hello]".strip_circumfix?("[", "]"), Some("hello"));
assert_eq("[[hello]]".strip_circumfix("[", "]"), "[hello]");
assert_eq("<tag>hello</tag>".strip_circumfix("<tag>", "</tag>"), "hello");
assert_eq("[hello".strip_circumfix?("[", "]"), None);
assert_eq("hello]".strip_circumfix?("[", "]"), None);
assert_eq("hello".strip_circumfix?("[", "]"), None);
assert_eq("aaa".strip_circumfix?("aa", "aa"), None);
assert_eq("a".strip_circumfix?("a", "a"), None);
assert_eq("[]".strip_circumfix("[", "]"), "");
assert_eq("hello".strip_circumfix("", ""), "hello");
assert_eq("hello]".strip_circumfix("", "]"), "hello");
assert_eq("[hello".strip_circumfix("[", ""), "hello");
assert_eq("".strip_circumfix("", ""), "");
assert_eq("".strip_circumfix?("[", "]"), None);
assert_eq("「你好❤」".strip_circumfix("「", "」"), "你好❤");
let original = "[hello]";
let stripped = original.strip_circumfix("[", "]");
stripped.append("!");
assert_eq(original, "[hello]");
assert_eq(stripped, "hello!");
