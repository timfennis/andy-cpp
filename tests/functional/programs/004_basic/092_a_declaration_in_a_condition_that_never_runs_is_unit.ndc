// A function declared in a condition is in scope after the `if` or `while`,
// and holds unit if the part of the condition it's in never ran: after a
// `false and`, in an `else if` whose `if` was taken, or after a `break`.
fn in_an_if() {
  if false and ((fn f() { 1 }) == ()) { }
  assert_eq(f, ());
}
in_an_if();

fn in_an_else_if() {
  if true { } else if (fn f() { 1 }) == () { }
  assert_eq(f, ());
}
in_an_else_if();

fn in_a_while() {
  let i = 0;
  while i > 0 and ((fn f() { 1 }) == ()) { }
  assert_eq(f, ());
}
in_a_while();

fn after_a_break() {
  while (if true { break } else { true }, fn f() { 1 })[0] { }
  assert_eq(f, ());
}
after_a_break();

{
  if true { } else if (fn f() { 1 }) == () { }
  assert_eq(f, ());
}

for i in 0..2 {
  if i < 5 { } else if (fn f() { i }) == () { }
  let read = fn() { f };
  assert_eq(read(), ());
}
