// A function declared where it never runs holds unit, not a value its
// caller left behind: calling it fails rather than calling `h`.
// expect-error: Unable to invoke () as a function.
fn g() {
  false and ((fn f() { 1 }) == ());
  print(f());
}
let h = fn() { 99 };
fn main() {
  if h == h { }
  g();
}
main();
