// A function declared in an operand that never runs, as the right operand of
// `and` or `or`, still declares its name, which holds unit, wherever it is.
// expect-output: true
fn main() {
  false and ((fn f() { 1 }) == ());
  print(f == ());
}
main();

fn in_a_function() {
  true or ((fn g() { 2 }) == ());
  assert_eq(g, ());
  assert_eq((false and ((fn h() { 3 }) == ()), h), (false, ()));
}
in_a_function();

{
  false and ((fn f() { 1 }) == ());
  assert_eq(f, ());
}

fn in_a_loop() {
  for i in 0..2 {
    false and ((fn f() { i }) == ());
    assert_eq(f, ());
  }
}
in_a_loop();

fn captured() {
  false and ((fn f() { 1 }) == ());
  let read = fn() { f };
  assert_eq(read(), ());
}
captured();

fn captured_by_itself() {
  false and ((fn countdown(n: Int) -> Int { if n > 0 { countdown(n - 1) } else { 0 } }) == ());
  assert_eq(countdown, ());
}
captured_by_itself();

fn in_a_comprehension() {
  assert_eq([(false and ((fn f() { x }) == ()), f) for x in [1, 2]], [(false, ()), (false, ())]);
}
in_a_comprehension();
