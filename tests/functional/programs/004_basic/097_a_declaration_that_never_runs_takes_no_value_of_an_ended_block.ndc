// A function declared where it may not run holds unit until it does, not
// what a variable of a block, loop or comprehension that ended before it held.
fn after_a_block() {
  { let q = fn() => 42; }
  false and ((fn f() { 5 }) == ());
  assert_eq(f, ());
}
after_a_block();

fn after_a_comprehension() {
  ([i for i in [7]] == [8]) and ((fn f() { 5 }) == ());
  assert_eq(f, ());
}
after_a_comprehension();

fn after_a_loop() {
  for i in 0..3 { }
  if false and ((fn f() { 5 }) == ()) { }
  let read = fn() { f };
  assert_eq(read(), ());
}
after_a_loop();

fn in_the_same_expression() {
  ({ let q = "text"; q } == "other") and ((fn f() { 5 }) == ());
  assert_eq(f, ());
}
in_the_same_expression();

{
  { let q = 1; }
  false and ((fn f() { 5 }) == ());
  assert_eq(f, ());
}
