assert(0b1111 == 15);
assert(0o7777 == 4095);
assert(0xffff == 65535);
assert(32rmmmm == 744150);
assert(36r10 == 36);
assert(36rZ == 35);
assert(2r101011 == 0b101011);

// Underscores are allowed
assert(0b10_10_10 == 42);
assert(0xf_Ff_dead == 268426925);

// Big numbers
assert(0b1111111111111111111111111111111111111111111111111111111111111111n == 18446744073709551615n);
assert(0xDEADDEADDEADDEADDEADn == 1051572691647698727460525n);
