// A cast is what lets a typed container overload be selected. `sum` has
// separate Int, Float, and Number overloads, and a value the analyser only
// knows as [Any] matches none of them, so each cast below picks a
// different overload at compile time. The variables still hold their lists,
// so a copy of each is cast.
let values: %{Any} = %{};
values.insert(1);
values.insert(2);
assert_eq(cast::<[Int]>(values.keys).sum(), 3);

let floats: [Any] = [1.0, 2.0, 3.0];
assert_eq(cast::<[Float]>(floats.clone()).sum(), 6.0);

let numbers: [Any] = [1n, 2n, 3n];
assert_eq(cast::<[Number]>(numbers.clone()).sum(), 6n);

// An empty container conforms vacuously, so the overload still resolves.
let empty: [Any] = [];
assert_eq(cast::<[Int]>(empty.clone()).sum(), 0);
