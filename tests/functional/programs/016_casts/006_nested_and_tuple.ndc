// A cast to a nested list, a tuple or a map checks what's inside them too.
let nested: Any = [[1], [2, 3]];
assert_eq(cast::<[[Int]]>(nested.deepcopy()), [[1], [2, 3]]);

let pair: Any = (1, "a");
assert_eq(cast::<(Int, String)>(pair), (1, "a"));

let map: Any = %{"a": 1};
assert_eq(cast::<%{String: Int}>(map.clone()), %{"a": 1});
