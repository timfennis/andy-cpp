// A tuple can't be written to, so one that `alias` holds too is cast as it
// is when there's no container in it to copy: this one holds an Int and
// None.
// expect-output: (1,None) Some((1,None))
let value: Any = (1, None);
let alias = value;
print(cast::<(Int, Option<[Int]>)>(value), cast?::<(Int, Option<[Int]>)>(alias));
