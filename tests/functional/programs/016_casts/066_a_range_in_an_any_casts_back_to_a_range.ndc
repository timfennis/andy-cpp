// A range knows it's a range, so a cast can check it: one held as an `Any`
// casts back to a `Range` or `RangeFrom` and indexes like any other, and a
// cast to another kind of sequence is `None`.
// expect-output: 1..3 [2,3]
// expect-output: None None
// expect-output: [30]
let a: Any = 1..3;
let r = cast::<Range>(a);
print(r, [1, 2, 3, 4][r]);
print(cast?::<RangeFrom>(a), cast?::<[Int]>(a));
let b: Any = 2..;
print([10, 20, 30][cast::<RangeFrom>(b)]);
