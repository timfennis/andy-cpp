// `words` holds Strings. If the cast gave the same list as a `[Any]`,
// a push of an Int through `anything` would put an Int in `words` too.
// expect-error: cannot cast to [Any]: the list is also held by something else
let words = "a b".split(" ");
let any: Any = words;
let anything = cast::<[Any]>(any);
anything.push(1);
