// What an iterator makes can't be checked without making it, so a cast can
// only prove it's an `Iterator<Any>`, or an `Iterator<Int>` for a range.
// expect-output: [1,2] None None
// expect-error: cannot cast Iterator<Any> to Iterator<String>
let a: Any = 1..3;
let taken: Any = take([1], 1);
print((a as Iterator<Int>).list(), a as? Iterator<String>, taken as? Iterator<Int>);
let b = a as Iterator<String>;
for s in b {
    print(s ++ "x");
}
