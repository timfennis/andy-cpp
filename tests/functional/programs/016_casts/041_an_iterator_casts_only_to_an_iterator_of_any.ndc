// What an iterator makes can't be checked without making it, so a cast can
// only make it an `Iterator<Any>`, whose elements are cast one by one.
// `as?` to an iterator of anything else is `None`.
let a: Any = 1..3;
print(a as? Iterator<Int>);
for x in a as Iterator<Any> {
    print((x as Int) * 10);
}
// expect-output: None
// expect-output: 10
// expect-output: 20
