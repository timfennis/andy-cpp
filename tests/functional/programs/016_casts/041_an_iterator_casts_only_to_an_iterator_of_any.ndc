// What an iterator makes can't be checked without making it, so a cast can
// only make it an `Iterator<Any>`, whose elements are cast one by one.
// `cast?` to an iterator of anything else is `None`.
let a: Any = [1, 2].take(2);
print(cast?::<Iterator<Int>>(a));
for x in cast::<Iterator<Any>>(a) {
    print(cast::<Int>(x) * 10);
}
// expect-output: None
// expect-output: 10
// expect-output: 20
