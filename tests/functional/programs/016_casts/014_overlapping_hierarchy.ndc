// A [Any] may hold only Ints, so the cast is possible and gets checked
// at runtime rather than rejected outright. A copy is cast, as `xs` and `m`
// still hold their containers.
let xs: [Any] = [1, 2];
assert_eq(xs.clone() as [Int], [1, 2]);

let m: %{Int: Any} = %{1: 2};
assert_eq(m.clone() as %{Int: Int}, %{1: 2});
