// Whether a cast is checked as the program runs depends on what's known
// about the value once the program is analysed, and in a generic function on
// the types each call gives it. Here every value already is a [Int], so
// a list held by another name casts fine.
let xs = [];
let c = cast?::<[Int]>(xs);
xs.push(1);
print(c);

fn f(ys) => cast::<[Int]>(ys);
let zs = [1];
print(f(zs));

let g = fn(ys) => cast::<[Int]>(ys);
print(g(zs));

fn is_ints(ys) => cast?::<[Int]>(ys).is_some();
print(is_ints(zs), is_ints(["a"]));
// expect-output: Some([1])
// expect-output: [1]
// expect-output: [1]
// expect-output: true false
