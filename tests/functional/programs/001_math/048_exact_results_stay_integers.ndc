// Division and the remainders build their result as a fraction. A denominator
// of one has to collapse back to an integer, or the value prints as `2` while
// no longer matching the integer arm any consumer switches on.
assert_eq(json_encode(4n / 2n), "2");
assert_eq(json_encode(7n %% 3n), "1");
assert_eq(json_encode(7n % 3n), "1");
assert_eq(json_encode(2n ^ 2n), "4");

// genuine fractions are untouched
assert_eq(4n / 3n, 4n / 3n);
assert_eq(denominator(4n / 3n), 3n);

// A negative power reaches the same normalization: the reciprocal of a whole
// number can itself be whole, and the rational-base branches likewise.
assert_eq(json_encode(1n ^ -1n), "1");
assert_eq(json_encode((1n/2n) ^ -1n), "2");
assert_eq(json_encode((1n/2n) ^ -2n), "4");
assert_eq(json_encode(abs(-4n/2n)), "2");

// a reciprocal that is genuinely fractional keeps its exact form
assert_eq(2n ^ -1n, 1n/2n);
assert_eq(denominator(2n ^ -1n), 2n);
