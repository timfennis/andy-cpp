// B1: the size of a range ending at the largest Int overflowed. It has one
// more element than the largest Int, which `len` reports.
// expect-output: 0..=9223372036854775807
// expect-output: 9223372036854775807
// expect-error: 0..=9223372036854775807 has more elements than an Int can count
print(0..=9223372036854775807);
print(len(1..=9223372036854775807));
print(len(0..=9223372036854775807));
