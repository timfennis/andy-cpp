// A call dispatched at run time among overloads that the calling function
// captured. `inner` calls `describe` with an argument of unknown type, so the
// call goes through an overload set whose candidates are upvalues, passed
// through `middle`. Resolving such a candidate used to panic with "upvalue
// resolution in overload sets".
fn outer() {
    fn describe(x: Int) { "int" }
    fn describe(x: String) { "string" }
    fn middle() {
        fn inner(v) { describe(v) }
        inner(1) ++ " " ++ inner("a")
    }
    middle()
}

print(outer());
// expect-output: int string
