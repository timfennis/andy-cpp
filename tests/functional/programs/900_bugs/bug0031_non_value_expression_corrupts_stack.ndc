// A `while` loop in a value position evaluates to `()`, and leaves the values
// around it as they were. It once left nothing on the VM's stack, shifting
// later slots so the VM called `1` as a function.
let x = 1;
print(while false {});
print(x);
let y = while false {};
assert_eq(y, ());
print(x + 1);
// expect-output:
// expect-output: 1
// expect-output: 2
