// `break`/`continue` inside a partially evaluated expression leaves the
// operands already read behind, and the loop goes on or stops as usual. They
// once leaked onto the VM's stack, unboundedly for `continue`, corrupting the
// iterator in for loops.
// `add` has one overload, which what `break` gives can pick.
fn add(a: Int, b: Int) -> Int { a + b }
let n = 0;
for x in [1, 2, 3] {
    n += 1;
    let y = add(x, continue);
}
assert_eq(n, 3);

// Callee and arguments are discarded; print is never called.
while true {
    print(add(1, break));
}

// Collection literal elements are discarded; push is never called.
let acc = [];
while true {
    acc.push([1, 2, break]);
}
assert_eq(acc, []);

// Index-assignment scaffolding (setter, container, index) is discarded.
let map = %{};
while true {
    map[add(1, break)] = 9;
}
assert_eq(map.len(), 0);

// A nested break leaves its own loop only.
let m = 0;
for i in [1, 2] {
    m += 10;
    for j in [1, 2] {
        m += 1;
        let z = (i, j, break);
    }
}
assert_eq(m, 22);
print("done");
// expect-output: done
