// A `for` with several iterations and guards runs the body for each
// combination the guards let through, the last iteration the innermost. A
// guard can read the variables of the iterations before it, and `break` and
// `continue` in the body act on the innermost iteration.
// expect-output: [(1,1),(1,3),(2,2),(2,4),(3,3),(4,4)]
// expect-output: [1,2,20,21,30,31,32]
// expect-output: [(0,0),(1,0),(2,0),(2,2)]
// expect-output: [1,10,3,30,5]

let pairs = [];
for x in 1..5, y in x..5, if (x + y) % 2 == 0 {
    pairs.push((x, y));
}
print(pairs);

let guarded_twice = [];
for x in 0..4, if x != 1, y in 0..3, if y != x {
    guarded_twice.push(x * 10 + y);
}
print(guarded_twice);

let stopped = [];
for x in 0..3, y in 0..3 {
    if y > x { break; }
    if y == 1 { continue; }
    stopped.push((x, y));
}
print(stopped);

fn nested_blocks() {
    let found = [];
    for row in [[1, 2], [3, 4], [5, 6]] {
        for v in row {
            if v % 2 == 0 { continue; }
            for w in [v, v * 10] {
                if w > 30 { break; }
                found.push(w);
            }
        }
    }
    found
}
print(nested_blocks());
