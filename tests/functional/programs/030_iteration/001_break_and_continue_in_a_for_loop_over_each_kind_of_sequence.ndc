// `continue` skips to the next element and `break` leaves the loop, for a
// `for` loop over a list, a tuple, a range, an endless range, a string, a map,
// a set, a deque and an iterator.
// expect-output: [1,3,10,30,100,102,104,1000,1001]
// expect-output: ["a","c","d"]
// expect-output: [(1,"a"),(3,"c")]
// expect-output: [5,7]
// expect-output: [1,2]
// expect-output: [3,6,9]

fn collect() {
    let out = [];
    for x in [1, 2, 3, 4, 5] {
        if x == 2 { continue; }
        if x == 4 { break; }
        out.push(x);
    }
    for x in (10, 20, 30) {
        if x == 20 { continue; }
        out.push(x);
    }
    for x in 100..200 {
        if x % 2 == 1 { continue; }
        if x > 104 { break; }
        out.push(x);
    }
    for x in (1000..) {
        if x == 1002 { break; }
        out.push(x);
    }
    out
}
print(collect());

let letters = [];
for c in "abcdef" {
    if c == "b" { continue; }
    if c == "e" { break; }
    letters.push(c);
}
print(letters);

let keys = [];
for k, v in %{1: "a", 2: "b", 3: "c"} {
    if k == 2 { continue; }
    keys.push((k, v));
}
print(keys.sorted);

let members = [];
for x in %{5, 6, 7} {
    if x == 6 { continue; }
    members.push(x);
}
print(members.sorted);

let d = Deque();
d.push_back(1);
d.push_back(2);
d.push_back(3);
let from_deque = [];
for x in d {
    if x == 3 { break; }
    from_deque.push(x);
}
print(from_deque);

let from_iterator = [];
for x in (1..).take(10) {
    if x % 3 != 0 { continue; }
    from_iterator.push(x);
}
print(from_iterator);
