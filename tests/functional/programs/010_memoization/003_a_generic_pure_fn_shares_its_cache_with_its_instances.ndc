// A generic `pure fn` is compiled once for each type it's called with, and
// they share its cache: a call through a value of it, which is the
// function itself, finds what a direct call computed.
// expect-output: 10 10 2.5 2
let calls = 0;
pure fn add(x, y) {
    calls += 1;
    x + y
}
let first = add(5, 5);
let f = add;
let second = f(5, 5);
let third = add(1.0, 1.5);
print(first, second, third, calls);
