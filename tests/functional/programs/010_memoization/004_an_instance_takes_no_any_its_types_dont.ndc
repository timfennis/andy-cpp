// The instance of `has` for a `[Any]` takes an `Any` for `v`, which the
// one for a `[Int]` doesn't.
// expect-error: No function called 'contains' found that matches the arguments '[Int], Any'
pure fn has(xs, v) { xs.contains(v) }
let anything: [Any] = [];
let numbers: [Int] = [];
let a: Any = "s";
print(has(anything, a));
print(has(numbers, a));
