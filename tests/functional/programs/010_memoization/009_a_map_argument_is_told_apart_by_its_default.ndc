// The maps hold the same entries, but a missing key gives each its default.
// A default function is told apart by its code: like the `pure fn` itself,
// what it uses from outside isn't part of the arguments.
// expect-output: 1 2 1 2 1 1
pure fn missing(m: Map<Int, Int>) => m[0];
fn defaulting_to(n) => %{: fn() => n};
print(
    missing(%{: 1}),
    missing(%{: 2}),
    missing(%{: fn() => 1}),
    missing(%{: fn() => 2}),
    missing(defaulting_to(1)),
    missing(defaulting_to(2)),
);
