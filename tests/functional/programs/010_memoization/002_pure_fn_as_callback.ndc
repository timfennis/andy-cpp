// A memoized function passed to a higher-order function must consult its cache
// like any other call, rather than being dispatched as a plain closure.
let calls = 0;
pure fn double(n: Int) -> Int {
    calls += 1;
    n * 2
}

assert_eq([1, 2, 3].map(double), [2, 4, 6]);
assert_eq(calls, 3);

// The repeated argument is served from the cache, so `calls` does not grow.
assert_eq([1, 1, 2].map(double), [2, 2, 4]);
assert_eq(calls, 3);
