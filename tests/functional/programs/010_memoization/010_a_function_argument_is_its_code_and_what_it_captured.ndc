// Closures made by one `fn` expression are told apart by the values of the
// variables they captured, including one that captures itself to recurse.
// expect-output: 1 2 1 2
pure fn call(f: Fn(Int) -> Int, n: Int) => f(n);
fn adding(k) => fn(n) => n + k;
fn reaching(k) {
    fn down(n) => if n == 0 { k } else { down(n - 1) };
    down
}
print(call(adding(0), 1), call(adding(1), 1), call(reaching(1), 3), call(reaching(2), 3));
