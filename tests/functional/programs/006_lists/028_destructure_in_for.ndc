let map = %{
  0: "foo",
  1: "bar",
  2: "baz",
  3: "quux",
};

// The set holds both the Int keys and the String values.
let set: Map<Any, ()> = %{};
for key, value in map {
    set.insert(key);
    set.insert(value);
}

let expected: Map<Any, ()> = %{0,1,2,3,"foo","bar","baz","quux"};
assert(set == expected);
