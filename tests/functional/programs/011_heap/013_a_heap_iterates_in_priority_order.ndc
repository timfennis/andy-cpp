// Everything that takes a sequence gives a heap's elements in the order the
// heap would pop them: a min-heap's smallest first, a max-heap's largest.
// expect-output: 6 [10,20,30] [3,2,1] 3 1 3 2 1
let low = MinHeap();
let high = MaxHeap();
for x in [2, 3, 1] {
    low.push(x);
    high.push(x);
}
let firsts = [];
for x in high {
    firsts.push(x);
}
print(low.sum(), low.map(fn(x) => x * 10), high.list(), low.len(), low.pop(), firsts.join(" "));
