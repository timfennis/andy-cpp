// `values` is a global. The top-level code's own locals are assigned first:
// slot 0 is `delta`. Preparing an indexed assignment then reserves
// non-overlapping compiler temporaries after the source locals' high-water
// mark: slot 1 holds the cached container, slot 2 the cached index and slot 3
// the operation's result passed to `[]=`.
// compile: stdlib
let values = [1]; values[0] += { let delta = 2; delta };
