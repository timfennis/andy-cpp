// `values` and `delta` take registers 0 and 1 of `f`'s frame. The temporaries
// of the indexed assignment come after them: r2 holds a copy of the container,
// r3 the index, r4 the sum, and r5 to r7 the arguments of `[]` and `[]=`, so
// `f` has 8 registers.
// compile: stdlib
fn f() {
    let values = [1];
    values[0] += { let delta = 2; delta };
    values
}
