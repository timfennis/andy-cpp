// `g` is declared in the right operand of `and`, which may not run, so it
// gets a register no other local shares, after theirs, and `outer` puts unit
// in it before anything else: a call doesn't clear the registers of the frame
// it makes. `a`'s register, free again after its block, would hold 1. `f`, a
// statement of the body, always runs before its name is read, and gets
// nothing.
// compile: stdlib
fn outer(x: Bool) {
    { let a = 1; }
    fn f() { 1 }
    x and ((fn g() { 2 }) == ());
    g
}
outer(false);
