// `g` is declared in the right operand of `and`, which may not run, so
// `outer` puts unit in its register before anything else: a call doesn't
// clear the registers of the frame it makes. `f`, a statement of the body,
// always runs before its name is read, and gets nothing.
// compile: stdlib
fn outer(x: Bool) {
    fn f() { 1 }
    x and ((fn g() { 2 }) == ());
    g
}
outer(false);
